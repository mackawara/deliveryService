# Serves the built dashboard inside its production container. TLS terminates at
# the host Caddy, which also routes /api/v1 to the API on the same origin
# (deliveryBooking/deploy/Caddyfile.example); this one only speaks plain HTTP
# on the compose network. Same policy as nginx.conf.example.
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		# Matches the meta tag in index.html; a header also enforces
		# frame-ancestors, which a meta tag cannot.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://maps.googleapis.com https://maps.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	# Backend routes belong to the API. Host Caddy sends them there before they
	# can reach this server, so arriving here means the routing is wrong. Say so
	# as an API-shaped error rather than answering with the app shell, which
	# would look like a working response to a client and a health check.
	@backend path /api/* /media/* /health /readyz
	handle @backend {
		header Cache-Control "no-store"
		header Content-Type "application/json"
		respond `{"code":"BACKEND_ROUTE_MISROUTED","message":"This path belongs to the API; the host Caddy routing is wrong."}` 502
	}

	# Vite emits content-hashed filenames under /assets — cache forever. A
	# missing asset stays a 404 instead of turning into the app shell.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Build identity: always revalidated, so a deployment shows up immediately.
	handle /version.json {
		header Cache-Control "no-store"
		file_server
	}

	# Everything else is the app shell or a public file. index.html is never
	# cached, so a deploy is picked up on the next load. Browser deep links fall
	# back to the shell for React Router, but a path that names a file (has an
	# extension) is a file request: missing means 404, never the app shell.
	handle {
		header Cache-Control "no-store"
		@file path_regexp file \.[A-Za-z0-9]+$
		handle @file {
			file_server
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
