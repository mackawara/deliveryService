# Public frontend configuration only. WhatsApp credentials, OTP/session secrets and
# authentication-template settings are server-side and must never appear here.

# Base URL for every delivery-service API call. The deployment baseline is a
# same-origin reverse proxy, so a relative path is the default.
VITE_API_BASE_URL=/api/v1

# Default country code offered by the staff login number field.
VITE_DEFAULT_PHONE_COUNTRY=+263

# Default brand preset: "orchid" (purple/pink) or "monochrome" (black/white).
# A saved user preference in the browser wins over this value.
VITE_DEFAULT_THEME=orchid

# Application label shown in the sidebar, top bar and document title.
VITE_APP_LABEL=Delivery Dashboard

# Timezone used to render API timestamps until towns define their own.
VITE_DEFAULT_TIMEZONE=Africa/Harare

# Dev/test only: serve the specified API contracts from in-browser mock handlers.
# Never enable this for a production build.
VITE_ENABLE_MOCK_API=false

# Dev server only: where /api/v1 is proxied during `yarn dev`.
VITE_DEV_API_PROXY_TARGET=http://localhost:4400

# Browser key for the zone boundary editor. Enable Maps JavaScript API and billing.
# Restrict the key to dashboard website origins and Maps JavaScript API only.
# Maps load only when an administrator opens a zone editor.
VITE_GOOGLE_MAPS_API_KEY=

# Build identity (set by the release workflow's Docker build arguments, not here).
# APP_VERSION, APP_REVISION and APP_BUILD_TIME are stamped into the UI and
# dist/version.json; locally they default to 0.0.0-dev / unknown.
