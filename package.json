{
  "name": "delivery-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Staff operations, finance and administration dashboard for the Hwange delivery service",
  "license": "MIT",
  "author": "mac kawara",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "doctor": "node scripts/doctor.mjs",
    "doctor:check": "node scripts/doctor.mjs --check",
    "verify": "yarn typecheck && yarn lint && yarn format && yarn doctor:check && yarn test && yarn build"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@reduxjs/toolkit": "2.12.0",
    "@turf/area": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/google.maps": "^3.66.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "msw": "2.15.0",
    "prettier": "3.9.8",
    "react-doctor": "0.9.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
